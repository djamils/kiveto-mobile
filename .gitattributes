# Every text file is stored and checked out with LF, whatever core.autocrlf
# says: bash scripts and the Makefile break on CRLF in Git Bash.
* text=auto eol=lf

# Windows-only scripts keep CRLF (gradlew.bat among them).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The Portal API contract is a byte copy of the backend file, checked by its
# sha256 (make api-check): never convert its line endings.
contracts/portal.v1.yaml -text

# Generated by make api-generate (tonik), committed: collapsed in diffs.
packages/kiveto_portal_api/** linguist-generated=true

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.pdf binary
*.jar binary

# Byte copies checked by their sha256 (assets/fonts/OFL.txt keeps the CRLF
# of google/fonts): never convert their line endings.
assets/fonts/OFL.txt -text
assets/licenses/lucide.txt -text

# gen-l10n output (fvm flutter gen-l10n), committed: collapsed in diffs.
lib/l10n/app_localizations*.dart linguist-generated=true
