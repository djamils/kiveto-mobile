<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: clear-text HTTP to the local backend through the
         emulator's host alias 10.0.2.2 (res/xml/network_security_config.xml),
         and the invitation deep link of the dev host, opened with
         adb shell am start -a android.intent.action.VIEW
           -d "https://portal.kiveto.local/invitation#t=<token>" app.kiveto.portal
         (no autoVerify: the dev host serves no assetlinks; the production
         host is not known yet). The dev backend writes its invitation SMS
         with http://portal.kiveto.local/invitation#t=…: both schemes. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name=".MainActivity" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data
                    android:scheme="https"
                    android:host="portal.kiveto.local"
                    android:pathPrefix="/invitation"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
