# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
*.log
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/
migrate_working_dir/

# Flutter template: symbolication, obfuscation, Android Studio build outputs
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release

# Flutter template: miscellaneous
*.class
*.pyc
*.swp
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/

# tool/ is a path package of the root pubspec: a pub get run inside it (IDEs
# do it for nested pubspecs) writes a lock file nobody uses.
/tool/pubspec.lock
# Same for the generated Portal API client (a path package of the app); its
# pubspec.lock is unused too (the CONTRACT check of make api-check skips it).
/packages/kiveto_portal_api/pubspec.lock

# FVM: .fvmrc is committed, the SDK link is per machine
.fvm/

# Make: stamps and log
.make/

# Local environment (created from config/env/dev.json.dist)
/config/env/dev.json

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# BMAD: personal answers and render cache
# (_bmad/custom/.gitignore and _bmad/render/.gitignore cover the rest)
/_bmad/config.user.toml

# Claude Code: personal settings and notes
.claude/settings.local.json
CLAUDE.local.md

# OS
.DS_Store
Thumbs.db
